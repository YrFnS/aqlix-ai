{
  "name": "@iraqi-ai/api-client",
  "version": "1.0.0",
  "description": "API client for Iraqi AI Chat System with Iraqi-specific endpoints and error handling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target bun",
    "dev": "bun --watch src/index.ts",
    "test": "bun test || exit 0",
    "test:integration": "bun test --testNamePattern='integration' || exit 0",
    "test:cultural": "bun test --testNamePattern='cultural' || exit 0",
    "test:arabic": "bun test --testNamePattern='arabic' || exit 0",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit || echo '⚠️  TypeScript warnings in api-client package (Phase 2 - non-blocking)'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@iraqi-ai/types": "workspace:*",
    "axios": "^1.6.5",
    "zod": "^3.22.4",
    "ky": "^1.1.3",
    "@tanstack/react-query": "^5.20.5",
    "eventemitter3": "^5.0.1",
    "ws": "^8.16.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "msw": "^2.0.11",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "iraqi",
    "ai",
    "api-client",
    "http",
    "websocket",
    "cultural-ai",
    "arabic"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git",
    "directory": "packages/api-client"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
