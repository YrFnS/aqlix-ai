{
  "name": "@iraqi-ai/ui",
  "version": "1.0.0",
  "description": "Shared UI components with Iraqi design patterns and Arabic RTL support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target bun",
    "dev": "bun --watch src/index.ts",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "test": "bun test",
    "test:visual": "chromatic --project-token=your-chromatic-token",
    "test:cultural": "bun test --testNamePattern='cultural'",
    "test:arabic": "bun test --testNamePattern='arabic'",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist storybook-static"
  },
  "dependencies": {
    "@iraqi-ai/types": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/forms": "^0.5.7",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.303.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "react-aria": "^3.32.1",
    "react-stately": "^3.30.1",
    "@react-aria/interactions": "^3.21.1",
    "@react-aria/utils": "^3.23.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@storybook/react": "^7.6.6",
    "@storybook/react-vite": "^7.6.6",
    "@storybook/addon-essentials": "^7.6.6",
    "@storybook/addon-a11y": "^7.6.6",
    "storybook": "^7.6.6",
    "chromatic": "^10.1.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "iraqi",
    "ui",
    "components",
    "react",
    "rtl",
    "arabic",
    "cultural-ai",
    "tailwindcss"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
