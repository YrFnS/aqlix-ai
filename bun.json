{
  "$schema": "https://bun.sh/schema.json",
  "name": "iraqi-ai-chat-system",
  "workspaces": ["apps/*", "packages/*"],
  "install": {
    "cache": {
      "dir": ".bun/cache",
      "disabled": false
    },
    "lockfile": {
      "path": "bun.lock",
      "save": true
    },
    "registry": {
      "url": "https://registry.npmjs.org/",
      "timeout": 30000
    },
    "production": false,
    "optional": true,
    "dev": true,
    "peer": false,
    "exact": false,
    "frozen": false
  },
  "run": {
    "bun": true,
    "silent": false,
    "cwd": ".",
    "shell": "bash"
  },
  "build": {
    "target": "bun",
    "format": "esm",
    "sourcemap": "external",
    "minify": false,
    "splitting": true,
    "outdir": "dist",
    "root": "src"
  },
  "test": {
    "root": ".",
    "preload": ["./test/setup.ts"],
    "smol": false,
    "coverage": true,
    "coverageDir": "coverage",
    "coverageReporter": ["text", "lcov", "html"],
    "bail": 0,
    "timeout": 5000,
    "setupFilesAfterEnv": ["./test/jest.setup.ts"],
    "exclude": [
      "**/examples/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**"
    ]
  }
}
