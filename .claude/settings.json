{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm run test:cultural)",
      "Bash(npm run test:arabic)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(python -m ruff:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(python -m black:*)",
      "Bash(python3 -m black:*)",
      "Edit",
      "MultiEdit", 
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Task",
      "TodoWrite",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-by-language.sh",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command", 
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cultural-validation.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/load-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "IRAQI_AI_PROJECT": "1",
    "RTL_SUPPORT": "enabled", 
    "CULTURAL_VALIDATION": "strict"
  }
}