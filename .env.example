# =============================================================================
# Iraqi AI Chat System - Root Environment Configuration
# =============================================================================
#
# SECURITY WARNING: Never commit actual .env files to version control!
# This is a template file. Copy to .env and fill in your actual values.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values
#   3. Keep .env in .gitignore (already configured)
#
# Bun Environment Loading Order:
#   1. .env (base configuration)
#   2. .env.development / .env.production / .env.test (based on NODE_ENV)
#   3. .env.local (local overrides, not committed)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Determines runtime behavior and feature availability
# Valid values: development | production | test
# Default: development
NODE_ENV=development

# Logging verbosity level
# Valid values: debug | info | warn | error
# Default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/iraqi_ai_chat
DATABASE_URL=postgresql://postgres:password@localhost:5432/iraqi_ai_chat

# Redis connection string (optional, for caching and session management)
# Format: redis://host:port
# Example: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Supabase project URL
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, NEVER expose to client)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# LLM provider selection
# Valid values: openai
# Default: openai
LLM_PROVIDER=openai

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
# SECURITY: Never commit this value, never log it
LLM_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use
# Valid values: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# OpenAI API base URL (optional, for custom endpoints)
# Default: https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# API secret key for JWT signing and encryption
# CRITICAL: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# SECURITY: Never commit this value, never log it
API_SECRET_KEY=your-secure-secret-key-at-least-32-characters-long

# CORS allowed origins (comma-separated for multiple origins)
# Production: Use specific domains only
# Development: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Iraqi Payment Gateway Configuration (Optional)
# -----------------------------------------------------------------------------
# ZainCash payment gateway API key
# Minimum transaction: 1000 IQD
# Get from: ZainCash merchant portal
# ZAINCASH_API_KEY=your-zaincash-api-key-here

# FastPay payment gateway API key
# Minimum transaction: 500 IQD
# Get from: FastPay merchant portal
# FASTPAY_API_KEY=your-fastpay-api-key-here

# NassWallet payment gateway API key
# Minimum transaction: 1000 IQD
# Get from: NassWallet merchant portal
# NASSWALLET_API_KEY=your-nasswallet-api-key-here

# -----------------------------------------------------------------------------
# Iraqi AI Specific Configuration
# -----------------------------------------------------------------------------
# Enable cultural validation for content and UI
# Valid values: true | false
# Default: true
# IMPORTANT: Should be enabled in production for Iraqi compliance
CULTURAL_VALIDATION_ENABLED=true

# Enable Arabic dialect processing
# Valid values: true | false
# Default: true
ARABIC_DIALECT_PROCESSING=true

# -----------------------------------------------------------------------------
# Monitoring and Error Tracking (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn-here

# Sentry environment name
# Valid values: development | staging | production
# SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable experimental features
# Valid values: true | false
# Default: false
# ENABLE_EXPERIMENTAL_FEATURES=false

# Enable multimodal capabilities (image, voice)
# Valid values: true | false
# Default: true
# ENABLE_MULTIMODAL=true

# -----------------------------------------------------------------------------
# Development Tools (Development Only)
# -----------------------------------------------------------------------------
# Enable debug mode (verbose logging, source maps)
# Valid values: true | false
# Default: false in production
# DEBUG_MODE=false

# Enable hot reload in development
# Valid values: true | false
# Default: true in development
# HOT_RELOAD=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# Next Steps:
#   1. Copy to .env: cp .env.example .env
#   2. Fill in actual values (replace all "your-*-here" placeholders)
#   3. For app-specific variables, see:
#      - apps/web/.env.example (Next.js frontend)
#      - apps/api/.env.example (Python backend)
#
# Documentation: docs/ENVIRONMENT_SETUP.md
# Security Guidelines: Never commit .env files, use strong secrets
# =============================================================================
