{
  "name": "iraqi-ai-chat-system",
  "version": "1.0.0",
  "description": "Iraqi AI Chat System - Advanced AI chat with Arabic Iraqi dialect support, cultural compliance, and multi-modal capabilities",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter ./apps/web dev",
    "dev:web": "bun run --filter ./apps/web dev",
    "dev:api": "bun run --filter ./apps/api dev",
    "dev:all": "concurrently -n \"WEB,API\" -c \"blue,green\" \"bun run dev:web\" \"bun run dev:api\"",
    "dev:full": "concurrently -n \"WEB,API,TYPES\" -c \"blue,green,yellow\" \"bun run dev:web\" \"bun run dev:api\" \"bun run --filter @iraqi-ai/types dev:watch\"",
    "build": "bun run build:clean && bun run build:packages && bun run build:apps && bun run build:analyze",
    "build:clean": "bun run --filter \"*\" clean",
    "build:packages": "bun run --filter \"packages/*\" build --parallel",
    "build:apps": "bun run --filter \"apps/*\" build --parallel",
    "build:production": "NODE_ENV=production bun run build",
    "build:analyze": "bun run --filter \"apps/*\" analyze",
    "build:cache:clear": "rm -rf .bun/cache && rm -rf node_modules/.cache",
    "start": "concurrently -n \"WEB,API\" -c \"blue,green\" \"bun run --filter ./apps/web start\" \"bun run --filter ./apps/api start\"",
    "test": "bun test packages/ test/ && bun run --filter \"apps/*\" test",
    "test:watch": "bun test packages/ test/ --watch",
    "test:unit": "bun test packages/ test/",
    "test:integration": "bun run --filter \"apps/*\" test:integration",
    "test:e2e": "bun run --filter \"apps/web\" test:e2e",
    "test:cultural": "bun run --filter \"*\" test:cultural",
    "test:arabic": "bun run --filter \"*\" test:arabic",
    "test:image": "bun run --filter \"*\" test:image",
    "test:voice": "bun run --filter \"*\" test:voice",
    "test:desktop": "bun run --filter \"*\" test:desktop",
    "test:coverage": "bun test --coverage",
    "test:all": "concurrently -n \"UNIT,E2E,CULTURAL,ARABIC\" \"bun run test:unit\" \"bun run test:e2e\" \"bun run test:cultural\" \"bun run test:arabic\"",
    "test:ci": "bun run test:unit && bun run test:integration && bun run test:cultural && bun run test:arabic",
    "lint": "bun run --filter \"*\" lint",
    "lint:fix": "bun run --filter \"*\" lint --fix",
    "typecheck": "bun run --filter \"*\" typecheck",
    "typecheck:watch": "bun run --filter \"*\" typecheck --watch",
    "clean": "bun run --filter \"*\" clean && rm -rf node_modules/.cache dist build .next",
    "reset": "bun run clean && rm -rf node_modules bun.lockb && bun install",
    "workspace:list": "bun pm ls --all",
    "workspace:outdated": "bun outdated --recursive",
    "postinstall": "bun pm ls"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimatch": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "supabase": "^2.47.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "iraqi",
    "ai",
    "chat",
    "arabic",
    "cultural-ai",
    "islamic",
    "rtl",
    "bun",
    "monorepo"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  }
}
