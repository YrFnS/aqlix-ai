{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [],
  "exclude": ["node_modules", ".next", "dist", "tests"],
  "files": [
    "next-env.d.ts",
    "src/app/layout.tsx",
    "src/app/(marketing)/layout.tsx",
    "src/app/(marketing)/page.tsx",
