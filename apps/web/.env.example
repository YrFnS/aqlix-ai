# Kiteb web application — public environment template
#
# P0 compiles and renders without external-service credentials. Copy this file
# to .env.local only when overriding defaults or enabling a later capability.
#
# NEXT_PUBLIC_* values are embedded in browser code. Never place secrets here.

# Optional backend URL. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Product environment used for public feature behavior.
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# P1: required only when the selected authentication and persistence design
# enables the Supabase browser client.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Optional monitoring and analytics.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/project
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Deferred capabilities remain disabled unless deliberately implemented.
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
NEXT_PUBLIC_ENABLE_MULTIMODAL=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Server and provider secrets do not belong in the web public environment file.
# Backend, model, storage-admin, database, payment, and signing credentials must
# be declared and validated in the server process that consumes them.
