# Kiteb web application — P1 public environment template
#
# Copy this file to .env.local when enabling the real account and workspace
# capability against a Supabase project.
#
# NEXT_PUBLIC_* values are embedded in browser code. Never place secrets here.

# Future capability-service URL. The current workspace CRUD path is same-origin
# Next.js and does not call FastAPI. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public product environment label.
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Required for P1 account access, sessions, PostgreSQL persistence, and RLS.
# The anonymous/publishable key is public by design; authorization is enforced by
# the signed-in session and database policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional public monitoring and analytics. Leave unset until intentionally used.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/project
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Deferred capability flags. A flag does not mean its capability is implemented.
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
NEXT_PUBLIC_ENABLE_MULTIMODAL=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Do not add server-only values here.
#
# SUPABASE_SERVICE_ROLE_KEY is not required for normal P1 account/workspace
# requests and must never be exposed to browser code. Model, storage-worker,
# payment, signing, and internal-service credentials belong only in the server
# process that owns the corresponding later-phase capability.
