# Kiteb web application — P1/P2 environment template
#
# Copy this file to .env.local for local development. Do not commit .env.local.
# Values with NEXT_PUBLIC_ are embedded in browser code and must never contain
# secrets. Values without NEXT_PUBLIC_ remain server-only.

# Future independently deployed capability-service URL. P1 workspace operations
# and P2 conversations currently use same-origin Next.js routes.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public product environment label.
# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Optional server deployment label used by capability guards.
# development | staging | production | test
APP_ENV=development

# Required for account access, sessions, PostgreSQL persistence, and RLS.
# The anonymous/publishable key is public by design; authorization is enforced by
# the signed-in session and database policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# P2 real provider configuration — server-only.
# The browser never receives this key. Provider history is reconstructed from
# authorized PostgreSQL messages and requests use store=false.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-a-server-only-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048

# Deterministic P2 fixture — local/test only.
# Never enable this in staging or production. Both values are required before the
# fixture adapter can run, and APP_ENV=staging/production rejects it regardless.
# AI_PROVIDER=fixture
# P2_ALLOW_FIXTURE_PROVIDER=true
# APP_ENV=test

# Optional public monitoring and analytics. Leave unset until intentionally used.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/project
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Deferred capability flags. A flag does not mean its capability is implemented.
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false
NEXT_PUBLIC_ENABLE_MULTIMODAL=false
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# SUPABASE_SERVICE_ROLE_KEY is not required for normal account, workspace, or
# conversation requests and must never be exposed to browser code. Storage-worker,
# payment, signing, and internal-service credentials belong only in the server
# process that owns the corresponding later-phase capability.
