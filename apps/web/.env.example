# =============================================================================
# Iraqi AI Chat System - Next.js Frontend Environment Configuration
# =============================================================================
#
# SECURITY WARNING: Never commit actual .env files to version control!
# This is a template file. Copy to .env.local and fill in your actual values.
#
# Usage:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in your actual values
#   3. Restart Next.js dev server
#
# IMPORTANT: Next.js Environment Variable Rules
#   - NEXT_PUBLIC_* variables are exposed to the browser (client-side)
#   - Regular variables are server-side only (NOT accessible in browser)
#   - Only NEXT_PUBLIC_* variables are bundled into the client JavaScript
# =============================================================================

# -----------------------------------------------------------------------------
# Next.js Configuration
# -----------------------------------------------------------------------------
# Application environment
# Valid values: development | production | test
NODE_ENV=development

# Server port
# Default: 3000
PORT=3000

# -----------------------------------------------------------------------------
# Client-Side Variables (Exposed to Browser)
# -----------------------------------------------------------------------------
# These variables are prefixed with NEXT_PUBLIC_ and are safe to expose

# API URL for backend communication
# Development: http://localhost:8000
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Enable cultural validation in client
# Valid values: true | false
# Default: true
NEXT_PUBLIC_CULTURAL_VALIDATION_ENABLED=true

# Enable Arabic dialect processing in UI
# Valid values: true | false
# Default: true
NEXT_PUBLIC_ARABIC_DIALECT_PROCESSING=true

# Application environment for client-side feature flags
# Valid values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Server-Side Only Variables (NOT Exposed to Browser)
# -----------------------------------------------------------------------------
# These variables are ONLY available in server components, API routes, and build time

# API secret key for server-side operations
# CRITICAL: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# SECURITY: NEVER use NEXT_PUBLIC_ prefix for secrets
API_SECRET_KEY=your-secure-secret-key-at-least-32-characters-long

# Supabase service role key (server-side only)
# Get from: https://app.supabase.com/project/_/settings/api
# SECURITY: NEVER expose this to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database URL for direct database access (if needed)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/iraqi_ai_chat

# Redis URL for server-side caching (optional)
# Format: redis://host:port
# REDIS_URL=redis://localhost:6379

# LLM Provider Configuration (server-side only)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# Iraqi Payment Gateway Keys (server-side only)
# SECURITY: NEVER expose payment gateway keys to client
# ZAINCASH_API_KEY=your-zaincash-api-key-here
# FASTPAY_API_KEY=your-fastpay-api-key-here
# NASSWALLET_API_KEY=your-nasswallet-api-key-here

# -----------------------------------------------------------------------------
# Monitoring and Analytics (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (can be client-side)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here

# Sentry environment name
# SENTRY_ENVIRONMENT=development

# Google Analytics measurement ID (client-side)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable experimental features
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable multimodal capabilities (image, voice)
# NEXT_PUBLIC_ENABLE_MULTIMODAL=true

# Enable offline mode
# NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# Next Steps:
#   1. Copy to .env.local: cp .env.example .env.local
#   2. Fill in actual values (replace all "your-*-here" placeholders)
#   3. Restart Next.js dev server: bun run dev
#   4. Verify environment validation at startup
#
# Documentation: docs/ENVIRONMENT_SETUP.md
# SECURITY: Never commit .env.local, never use NEXT_PUBLIC_ for secrets
# =============================================================================
