{
  "name": "@iraqi-ai/web",
  "version": "1.0.0",
  "description": "Iraqi AI Chat System - Next.js 15 + React 19 Web Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port 3000",
    "build": "next build",
    "build:standalone": "next build && next export",
    "start": "next start",
    "analyze": "ANALYZE=true next build",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:cultural": "bun test --testNamePattern='cultural'",
    "test:arabic": "bun test --testNamePattern='arabic'",
    "clean": "rm -rf .next out dist .turbo"
  },
  "dependencies": {
    "@iraqi-ai/types": "workspace:*",
    "@iraqi-ai/ui": "workspace:*",
    "@iraqi-ai/features": "workspace:*",
    "@iraqi-ai/api-client": "workspace:*",
    "@iraqi-ai/arabic-nlp": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.1",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "zustand": "^4.4.7",
    "@tanstack/react-query": "^5.20.5",
    "react-hook-form": "^7.48.2",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.2",
    "react-dropzone": "^14.2.3",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.303.0",
    "date-fns": "^3.2.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "@playwright/test": "^1.40.1",
    "@next/bundle-analyzer": "^15.0.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32"
  },
  "keywords": [
    "iraqi",
    "ai",
    "chat",
    "nextjs",
    "react",
    "arabic",
    "rtl",
    "cultural-ai"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
