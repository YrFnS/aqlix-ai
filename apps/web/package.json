{
  "name": "@iraqi-ai/web",
  "version": "1.0.0",
  "description": "Tuppra web application for an Arabic-first bilingual AI workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo --port 3000",
    "build": "next build --experimental-build-mode=compile",
    "build:release": "node ../../node_modules/next/dist/bin/next build",
    "build:standalone": "next build && next export",
    "start": "next start",
    "start:release": "node ../../node_modules/next/dist/bin/next start -H 0.0.0.0",
    "analyze": "ANALYZE=true next build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit -p tsconfig.rebuild.json",
    "typecheck:watch": "tsc --noEmit -p tsconfig.rebuild.json --watch",
    "typecheck:legacy": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/rebuild",
    "test:watch": "bun test tests/rebuild --watch",
    "test:rebuild": "bun test tests/rebuild",
    "test:rebuild:brand": "bun test tests/rebuild/brand-and-scope.test.ts",
    "test:rebuild:rtl": "bun test tests/rebuild/rtl-foundation.test.ts",
    "test:rebuild:accessibility": "bun test tests/rebuild/accessibility-foundation.test.ts",
    "test:rebuild:p1": "bun test tests/rebuild/p1-workspace-foundation.test.ts",
    "test:rebuild:p2": "bun test tests/rebuild/p2-provider-boundary.test.ts",
    "test:rebuild:p3": "bun test tests/rebuild/p3-document-processor.test.ts tests/rebuild/p3-document-source-boundary.test.ts",
    "test:rebuild:p4": "bun test tests/rebuild/p4-draft-scaffold-export.test.ts tests/rebuild/p4-draft-boundary.test.ts",
    "test:rebuild:p5": "bun test tests/rebuild/p5-operational-baseline.test.ts tests/rebuild/p5-openrouter-byok.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:p1": "playwright test --config=playwright.p1.config.ts",
    "test:e2e:p2": "playwright test --config=playwright.p2.config.ts",
    "test:e2e:p3": "playwright test --config=playwright.p3.config.ts",
    "test:e2e:p4": "playwright test --config=playwright.p4.config.ts",
    "test:e2e:p5": "playwright test --config=playwright.p5.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:unit:legacy": "bun test --preload ./tests/setup/global-setup.ts --preload ./tests/setup/test-env.ts --preload ./tests/setup/custom-matchers.ts tests/unit",
    "test:cultural:legacy": "bun test --preload ./tests/setup/global-setup.ts --preload ./tests/setup/test-env.ts --preload ./tests/setup/custom-matchers.ts tests/unit/cultural-compliance.test.tsx",
    "test:arabic:legacy": "playwright test tests/e2e/arabic-rtl.spec.ts tests/e2e/rtl-foundation.spec.ts tests/e2e/bidirectional-ui.spec.ts",
    "test:accessibility:legacy": "bun test --preload ./tests/setup/global-setup.ts --preload ./tests/setup/test-env.ts --preload ./tests/setup/custom-matchers.ts tests/unit/language-switcher-accessibility.test.tsx",
    "clean": "rm -rf .next out dist .turbo"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@iraqi-ai/api-client": "workspace:*",
    "@iraqi-ai/arabic-nlp": "workspace:*",
    "@iraqi-ai/features": "workspace:*",
    "@iraqi-ai/supabase-client": "workspace:*",
    "@iraqi-ai/types": "workspace:*",
    "@iraqi-ai/ui": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/react-query": "^5.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.2.0",
    "lucide-react": "^0.303.0",
    "motion": "12.43.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.48.2",
    "tailwindcss": "^3.4.1",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.0.0",
    "@playwright/test": "^1.40.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.11.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "happy-dom": "^20.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "tuppra",
    "arabic",
    "ai",
    "workspace",
    "documents",
    "drafts",
    "bilingual",
    "rtl",
    "nextjs",
    "react"
  ],
  "author": "Tuppra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YrFnS/tuppra.git",
    "directory": "apps/web"
  },
  "engines": {
    "node": ">=24.14.1 <25.0.0",
    "bun": ">=1.3.14 <2.0.0"
  }
}
