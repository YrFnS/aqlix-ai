# =============================================================================
# Iraqi AI Chat System - Python FastAPI Backend Environment Configuration
# =============================================================================
#
# SECURITY WARNING: Never commit actual .env files to version control!
# This is a template file. Copy to .env and fill in your actual values.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values
#   3. Restart FastAPI server: bun run dev:api
#
# IMPORTANT: Python Environment Variable Notes
#   - Loaded automatically by pydantic-settings
#   - All variables are server-side (no client exposure)
#   - Type validation and coercion handled by pydantic
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Application environment
# Valid values: development | production | test
NODE_ENV=development

# Server configuration
# Port for FastAPI application
# Default: 8000
PORT=8000

# Host binding address
# Development: 127.0.0.1 or 0.0.0.0
# Production: 0.0.0.0
HOST=0.0.0.0

# Logging level
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Enable debug mode (verbose logging, auto-reload)
# Valid values: true | false
# Default: true in development, false in production
DEBUG=true

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# API secret key for JWT signing and encryption
# CRITICAL: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# SECURITY: Never commit this value, never log it
API_SECRET_KEY=your-secure-secret-key-at-least-32-characters-long

# JWT token expiration in minutes
# Default: 60 (1 hour)
JWT_EXPIRATION_MINUTES=60

# CORS allowed origins (comma-separated)
# Development: http://localhost:3000
# Production: https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CORS allow credentials
# Valid values: true | false
# Default: true
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/iraqi_ai_chat
DATABASE_URL=postgresql://postgres:password@localhost:5432/iraqi_ai_chat

# Database pool size
# Default: 5
DB_POOL_SIZE=5

# Database max overflow
# Default: 10
DB_MAX_OVERFLOW=10

# Database pool timeout in seconds
# Default: 30
DB_POOL_TIMEOUT=30

# Redis connection string (optional, for caching and sessions)
# Format: redis://host:port/db
# Example: redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# Redis password (if required)
# REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Supabase project URL
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (for client operations)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (for admin operations)
# Get from: https://app.supabase.com/project/_/settings/api
# SECURITY: Never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# LLM provider selection
# Valid values: openai
# Default: openai
LLM_PROVIDER=openai

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
# SECURITY: Never commit this value, never log it
LLM_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use
# Valid values: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# OpenAI API base URL (optional, for custom endpoints)
# Default: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# LLM request timeout in seconds
# Default: 60
LLM_TIMEOUT=60

# LLM max retries on failure
# Default: 3
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Iraqi Payment Gateway Configuration (Optional)
# -----------------------------------------------------------------------------
# ZainCash payment gateway configuration
# Minimum transaction: 1000 IQD
# Get API key from: ZainCash merchant portal
# ZAINCASH_API_KEY=your-zaincash-api-key-here
# ZAINCASH_BASE_URL=https://api.zaincash.iq
# ZAINCASH_MERCHANT_ID=your-merchant-id

# FastPay payment gateway configuration
# Minimum transaction: 500 IQD
# Get API key from: FastPay merchant portal
# FASTPAY_API_KEY=your-fastpay-api-key-here
# FASTPAY_BASE_URL=https://api.fastpay.iq
# FASTPAY_MERCHANT_ID=your-merchant-id

# NassWallet payment gateway configuration
# Minimum transaction: 1000 IQD
# Get API key from: NassWallet merchant portal
# NASSWALLET_API_KEY=your-nasswallet-api-key-here
# NASSWALLET_BASE_URL=https://api.nasswallet.iq
# NASSWALLET_MERCHANT_ID=your-merchant-id

# -----------------------------------------------------------------------------
# Iraqi AI Specific Configuration
# -----------------------------------------------------------------------------
# Enable cultural validation for content and responses
# Valid values: true | false
# Default: true
# IMPORTANT: Should be enabled in production for Iraqi compliance
CULTURAL_VALIDATION_ENABLED=true

# Enable Arabic Iraqi dialect processing
# Valid values: true | false
# Default: true
ARABIC_DIALECT_PROCESSING=true

# Cultural validation strictness level
# Valid values: low | medium | high
# Default: high
CULTURAL_VALIDATION_LEVEL=high

# Arabic text processing engine
# Valid values: default | advanced
# Default: default
ARABIC_PROCESSING_ENGINE=default

# -----------------------------------------------------------------------------
# Monitoring and Error Tracking (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn-here

# Sentry environment name
# Valid values: development | staging | production
# SENTRY_ENVIRONMENT=development

# Sentry sample rate (0.0 to 1.0)
# Default: 1.0 (100%)
# SENTRY_SAMPLE_RATE=1.0

# Sentry traces sample rate (0.0 to 1.0)
# Default: 0.1 (10%)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Enable rate limiting
# Valid values: true | false
# Default: true
RATE_LIMIT_ENABLED=true

# Rate limit per minute per IP
# Default: 60
RATE_LIMIT_PER_MINUTE=60

# Rate limit per hour per user
# Default: 1000
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# File Storage Configuration (Optional)
# -----------------------------------------------------------------------------
# File upload max size in MB
# Default: 10
MAX_UPLOAD_SIZE_MB=10

# Allowed file extensions (comma-separated)
# Default: jpg,jpeg,png,gif,pdf,txt,doc,docx
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,doc,docx

# File storage location
# Valid values: local | s3 | supabase
# Default: local
FILE_STORAGE_TYPE=local

# Local storage path
# Default: ./uploads
LOCAL_STORAGE_PATH=./uploads

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable experimental features
# Valid values: true | false
# Default: false
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable multimodal capabilities (image, voice processing)
# Valid values: true | false
# Default: true
ENABLE_MULTIMODAL=true

# Enable background task processing
# Valid values: true | false
# Default: true
ENABLE_BACKGROUND_TASKS=true

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# Next Steps:
#   1. Copy to .env: cp .env.example .env
#   2. Fill in actual values (replace all "your-*-here" placeholders)
#   3. Install dependencies: pip install -r requirements.txt
#   4. Start FastAPI server: uvicorn main:app --reload
#   5. Verify environment validation at startup
#
# Documentation: docs/ENVIRONMENT_SETUP.md
# Security Guidelines: Never commit .env files, use strong secrets
# =============================================================================
