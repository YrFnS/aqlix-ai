{
  "name": "@iraqi-ai/mobile",
  "version": "1.0.0",
  "description": "Iraqi AI Chat System - React Native Mobile Application (Future Development)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo \"Mobile app development starting in Phase 2\" && exit 0",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build": "echo \"Mobile build not implemented yet\" && exit 0",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/IraqiAI.xcworkspace -scheme IraqiAI -configuration Release -sdk iphoneos -derivedDataPath ios/build",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "test": "bun test || exit 0",
    "test:e2e": "detox test",
    "test:cultural": "bun test --testNamePattern='cultural' || exit 0",
    "test:arabic": "bun test --testNamePattern='arabic' || exit 0",
    "clean": "rm -rf node_modules ios/build android/build dist"
  },
  "dependencies": {
    "@iraqi-ai/types": "workspace:*",
    "@iraqi-ai/ui": "workspace:*",
    "@iraqi-ai/features": "workspace:*",
    "@iraqi-ai/api-client": "workspace:*",
    "@iraqi-ai/arabic-nlp": "workspace:*",
    "react": "^18.2.0",
    "react-native": "^0.73.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-gesture-handler": "^2.14.1",
    "react-native-reanimated": "^3.6.1",
    "react-native-vector-icons": "^10.0.3",
    "zustand": "^4.4.7",
    "@tanstack/react-query": "^5.20.5",
    "react-hook-form": "^7.48.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.45",
    "@types/react-native": "^0.73.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "metro-config": "^0.80.3",
    "@react-native/metro-config": "^0.73.3",
    "detox": "^20.15.2"
  },
  "keywords": [
    "iraqi",
    "ai",
    "chat",
    "mobile",
    "react-native",
    "arabic",
    "rtl",
    "cultural-ai"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git",
    "directory": "apps/mobile"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
