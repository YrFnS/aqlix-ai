{
  "name": "iraqi-enterprise-auth",
  "version": "1.0.0",
  "description": "Enterprise authentication system for Iraqi government ministries with cultural intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cultural": "jest --testPathPattern=cultural",
    "test:security": "jest --testPathPattern=security",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node-dev src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "authentication",
    "enterprise",
    "iraqi-government",
    "biometric",
    "sso",
    "islamic-compliance",
    "arabic-rtl",
    "ministry-rbac",
    "security-clearance",
    "government-audit"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "dependencies": {
    "crypto": "^1.0.1",
    "events": "^3.3.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "typescript": "^5.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.45.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/tests/**"
    ]
  }
}