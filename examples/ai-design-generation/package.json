{
  "name": "@aqlix-ai/ai-design-generation",
  "version": "2.0.0",
  "description": "Enhanced AI Design Generation System (Priority 1.2) - Revolutionary AI-powered design generation with comprehensive Islamic compliance, Arabic-first intelligence, and ministry-specific automation for Iraqi government applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build --target=node --outdir=dist src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:cultural": "bun test --grep=\"Cultural Design Intelligence\"",
    "test:islamic": "bun test --grep=\"Islamic Design AI\"",
    "test:rtl": "bun test --grep=\"RTL Component Generation\"",
    "test:accessibility": "bun test --grep=\"Accessibility Validation\"",
    "test:ministry": "bun test --grep=\"Ministry Templates\"",
    "test:typography": "bun test --grep=\"Arabic Typography AI\"",
    "test:branding": "bun test --grep=\"Ministry Branding AI\"",
    "test:validation": "bun test --grep=\"Cultural Design Validator\"",
    "test:integration": "bun test --grep=\"Integration\"",
    "test:ai": "bun test --grep=\"AI Design Orchestrator\"",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "docs": "typedoc src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "bun src/index.ts",
    "benchmark": "bun run benchmark/ai-design-generation.ts",
    "benchmark:ai": "bun run benchmark/ai-orchestrator-performance.ts",
    "benchmark:islamic": "bun run benchmark/islamic-compliance-speed.ts",
    "benchmark:typography": "bun run benchmark/arabic-typography-optimization.ts",
    "demo": "bun run demo/ai-design-demo.ts",
    "demo:ministry": "bun run demo/ministry-branding-demo.ts",
    "demo:cultural": "bun run demo/cultural-validation-demo.ts",
    "demo:arabic": "bun run demo/arabic-typography-demo.ts",
    "ai:setup": "bun run scripts/setup-ai-models.ts",
    "ai:validate": "bun run scripts/validate-ai-integration.ts",
    "ai:benchmark": "bun run scripts/benchmark-ai-performance.ts"
  },
  "keywords": [
    "ai-design-generation",
    "iraqi-ai",
    "cultural-intelligence",
    "islamic-compliance",
    "arabic-rtl",
    "government-ui",
    "ministry-templates",
    "accessibility",
    "wcag-compliance",
    "design-automation",
    "ui-generation",
    "cultural-validation",
    "arabic-typography",
    "rtl-layout",
    "bidi-text",
    "iraqi-dialect",
    "government-standards",
    "professional-ui",
    "cultural-patterns",
    "design-system",
    "ai-orchestrator",
    "islamic-design-ai",
    "ministry-branding-ai",
    "arabic-typography-ai",
    "cultural-design-validator",
    "llm-integration",
    "claude-3-5-sonnet",
    "gpt-4-vision",
    "gemini-pro",
    "real-time-validation",
    "ai-powered-branding",
    "automated-compliance",
    "intelligent-typography",
    "prayer-time-aware",
    "halal-design-validation",
    "iraqi-government-standards"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aqlix-ai/ai-design-generation.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "ai": "^3.0.0",
    "zod": "^3.22.4",
    "events": "^3.3.0",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "date-fns": "^2.30.0",
    "color": "^4.2.3",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/color": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "typedoc": "^0.25.4",
    "bun-types": "latest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./ai-orchestrator": {
      "types": "./dist/src/AIDesignOrchestrator.d.ts",
      "import": "./dist/src/AIDesignOrchestrator.js"
    },
    "./islamic-ai": {
      "types": "./dist/src/IslamicDesignAI.d.ts",
      "import": "./dist/src/IslamicDesignAI.js"
    },
    "./typography-ai": {
      "types": "./dist/src/ArabicTypographyAI.d.ts",
      "import": "./dist/src/ArabicTypographyAI.js"
    },
    "./cultural-validator": {
      "types": "./dist/src/CulturalDesignValidator.d.ts",
      "import": "./dist/src/CulturalDesignValidator.js"
    },
    "./ministry-branding": {
      "types": "./dist/src/MinistryBrandingAI.d.ts",
      "import": "./dist/src/MinistryBrandingAI.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./cultural": {
      "types": "./dist/core/CulturalPromptSystem.d.ts",
      "import": "./dist/core/CulturalPromptSystem.js"
    },
    "./rtl": {
      "types": "./dist/core/RTLComponentGenerator.d.ts",
      "import": "./dist/core/RTLComponentGenerator.js"
    },
    "./ministry": {
      "types": "./dist/core/MinistryTemplateManager.d.ts",
      "import": "./dist/core/MinistryTemplateManager.js"
    },
    "./accessibility": {
      "types": "./dist/core/AccessibilityValidator.d.ts",
      "import": "./dist/core/AccessibilityValidator.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "ai_design_generation": {
      "cultural_compliance_threshold": 96.2,
      "islamic_compliance_threshold": 98.9,
      "rtl_accuracy_threshold": 99.1,
      "accessibility_threshold": 95,
      "ministry_compliance_threshold": 100,
      "government_standards_required": true,
      "real_time_validation": true,
      "ai_powered_optimization": true
    },
    "ai_models": {
      "primary_model": "claude-3-5-sonnet",
      "fallback_models": ["gpt-4-vision", "gemini-pro", "local-llm"],
      "cultural_validation_model": "claude-3-5-sonnet",
      "typography_optimization_model": "gpt-4-vision",
      "ministry_branding_model": "claude-3-5-sonnet",
      "real_time_model": "gemini-pro",
      "offline_model": "local-llm"
    },
    "performance": {
      "max_generation_time_ms": 200,
      "max_validation_time_ms": 100,
      "max_typography_optimization_ms": 150,
      "max_branding_application_ms": 300,
      "cache_size": 5000,
      "parallel_validations": true,
      "optimization_enabled": true,
      "edge_ai_processing": true
    },
    "cultural_intelligence": {
      "enable_islamic_validation": true,
      "enable_iraqi_patterns": true,
      "enable_ministry_branding": true,
      "enable_arabic_typography": true,
      "enable_cultural_colors": true,
      "enable_prayer_time_awareness": true,
      "enable_halal_content_validation": true,
      "enable_family_values_checking": true,
      "enable_generational_respect": true,
      "enable_community_values": true
    },
    "ministry_support": {
      "health": {
        "enabled": true,
        "ai_specialization": "medical-design",
        "cultural_focus": "patient-care",
        "islamic_level": "moderate",
        "colors": ["emerald-600", "teal-700", "green-500"]
      },
      "education": {
        "enabled": true,
        "ai_specialization": "educational-design",
        "cultural_focus": "family-values",
        "islamic_level": "strict",
        "colors": ["blue-600", "indigo-700", "sky-500"]
      },
      "interior": {
        "enabled": true,
        "ai_specialization": "government-services",
        "cultural_focus": "national-identity",
        "islamic_level": "moderate",
        "security": "classified",
        "colors": ["slate-600", "gray-700", "zinc-600"]
      },
      "justice": {
        "enabled": true,
        "ai_specialization": "legal-design",
        "cultural_focus": "islamic-law",
        "islamic_level": "strict",
        "security": "high",
        "colors": ["purple-600", "indigo-700", "violet-600"]
      },
      "general_government": true
    },
    "accessibility": {
      "wcag_level": "AA+",
      "government_standard_compliance": true,
      "arabic_screen_readers": true,
      "rtl_keyboard_navigation": true,
      "cultural_feedback": true,
      "contrast_validation": true,
      "cognitive_accessibility": true,
      "motor_accessibility": true,
      "visual_impairment_support": true,
      "arabic_accessibility_optimization": true
    },
    "rtl_features": {
