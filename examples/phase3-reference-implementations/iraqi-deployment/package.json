{
  "name": "@iraqi-ai/deployment",
  "version": "1.0.0",
  "description": "Iraqi AI Chat System Production Deployment Configuration and Orchestration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:js": "bun build src/index.ts --outdir dist --format esm --target bun",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:deployment": "bun test --grep 'Deployment'",
    "test:health": "bun test --grep 'Health'",
    "test:performance": "bun test --grep 'Performance'",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "deploy:staging": "bun run build && bun run deploy:docker:staging",
    "deploy:production": "bun run build && bun run deploy:docker:production",
    "deploy:docker:staging": "docker-compose -f docker-compose.staging.yml up -d",
    "deploy:docker:production": "docker-compose -f docker-compose.prod.yml up -d",
    "health-check": "bun src/health/health-checker.ts",
    "health-check:production": "NODE_ENV=production bun src/health/health-checker.ts",
    "performance:benchmark": "bun src/performance/benchmark.ts",
    "cultural:validate": "bun src/validation/cultural-validator.ts",
    "arabic:test": "bun src/testing/arabic-nlp-test.ts",
    "professional:validate": "bun src/testing/professional-validation-test.ts",
    "learning:test": "bun src/testing/cultural-learning-test.ts"
  },
  "dependencies": {
    "@iraqi-ai/types": "workspace:*",
    "@iraqi-ai/cultural-engine": "workspace:*",
    "@iraqi-ai/arabic-nlp": "workspace:*",
    "@iraqi-ai/professional-domains": "workspace:*",
    "@iraqi-ai/cultural-learning": "workspace:*",
    "prom-client": "^15.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "zod": "^3.22.4",
    "date-fns": "^3.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1"
  },
  "keywords": [
    "iraqi",
    "deployment",
    "production",
    "docker",
    "kubernetes",
    "monitoring",
    "health-check",
    "performance",
    "cultural-ai"
  ],
  "author": "Iraqi AI Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-ai/aqlix-ai.git",
    "directory": "packages/iraqi-deployment"
  }
}
