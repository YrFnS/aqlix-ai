{
  "name": "iraqi-ai-chat-desktop",
  "version": "1.0.0",
  "description": "نظام الدردشة الذكي العراقي - تطبيق سطح المكتب (Iraqi AI Chat System - Desktop App)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "bun run build:main && concurrently \"bun run watch:main\" \"bun run watch:renderer\" \"electron .\"",
    "build": "bun run build:main && bun run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "webpack --config webpack.renderer.config.js --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "dist": "bun run build && electron-builder",
    "dist:win": "bun run build && electron-builder --win",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:all": "bun run build && electron-builder --win --mac --linux",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "keywords": ["iraqi-ai", "chat", "desktop", "electron", "rtl", "arabic", "government"],
  "author": "Iraqi AI Development Team",
  "license": "Proprietary - Iraqi Government Use",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "electron-store": "^8.0.0",
    "electron-updater": "^6.0.0",
    "electron-context-menu": "^3.0.0",
    "crypto": "^1.0.1"
  },
  "build": {
    "appId": "com.iraqi-ai.chat.desktop",
    "productName": "Iraqi AI Chat System",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "assets/**/*"],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}