{
  "name": "iraqi-ai-chat-desktop",
  "productName": "Iraqi AI Chat System Desktop",
  "version": "1.0.0",
  "description": "Enhanced desktop application for Iraqi AI Chat System with Arabic-first interface, government compliance, and offline capabilities",
  "main": "dist/main.js",
  "homepage": "https://iraqi-ai.gov.iq",
  "author": {
    "name": "Iraqi Ministry of Communications and Technology",
    "email": "support@iraqi-ai.gov.iq",
    "url": "https://iraqi-ai.gov.iq"
  },
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "https://github.com/iraqi-government/iraqi-ai-chat-desktop.git"
  },
  "keywords": [
    "iraqi-ai",
    "desktop",
    "electron",
    "arabic",
    "rtl",
    "government",
    "enterprise",
    "offline",
    "chat",
    "ai",
    "professional-domains"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development electron-webpack dev",
    "dev:renderer": "cross-env NODE_ENV=development webpack serve --config webpack.renderer.config.js",
    "build": "electron-webpack",
    "build:main": "electron-webpack main",
    "build:renderer": "electron-webpack renderer",
    "clean": "rimraf dist",
    "compile": "npm run build",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --win --mac --linux",
    "pack:win": "electron-builder --win --dir",
    "pack:mac": "electron-builder --mac --dir",
    "pack:linux": "electron-builder --linux --dir",
    "start": "electron dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "analyze": "webpack-bundle-analyzer dist/renderer/main.js",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@reduxjs/toolkit": "^2.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "electron-window-state": "^5.0.3",
    "i18next": "^23.7.16",
    "i18next-electron-fs-backend": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.20.1",
    "styled-components": "^6.1.6",
    "framer-motion": "^10.16.16",
    "date-fns": "^3.0.6",
    "date-fns-jalali": "^3.0.0-0",
    "recharts": "^2.8.0",
    "react-hook-form": "^7.48.2",
    "react-hotkeys-hook": "^4.4.1",
    "crypto-js": "^4.2.0",
    "node-machine-id": "^1.1.12",
    "electron-context-menu": "^3.6.1",
    "electron-debug": "^3.2.0",
    "electron-log": "^5.0.1",
    "sqlite3": "^5.1.6",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.1",
    "mime-types": "^2.1.35",
    "sharp": "^0.33.1",
    "pdf-parse": "^1.1.1",
    "arabic-reshaper": "^3.0.0",
    "bidi-js": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.34",
    "@types/crypto-js": "^4.2.1",
    "@types/uuid": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^27.1.3",
    "electron-builder": "^24.8.1",
    "electron-webpack": "^2.8.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "typescript": "^5.3.3",
    "ts-loader": "^9.5.1",
    "html-webpack-plugin": "^5.5.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "playwright": "^1.40.1",
    "@playwright/test": "^1.40.1",
    "rimraf": "^5.0.5",
    "webpack-bundle-analyzer": "^4.10.1"
  },
  "electronWebpack": {
    "main": {
      "sourceDirectory": "src/main",
      "webpackConfig": "webpack.main.config.js"
    },
    "renderer": {
      "sourceDirectory": "src/renderer",
      "webpackConfig": "webpack.renderer.config.js"
    },
    "whiteListedModules": [
      "electron-store",
      "electron-updater",
      "better-sqlite3",
      "crypto-js",
      "arabic-reshaper",
      "bidi-js"
    ]
  },
  "build": {
    "appId": "iq.gov.iraqi-ai.desktop",
    "productName": "Iraqi AI Chat System",
    "copyright": "Copyright © 2024 Iraqi Government - Ministry of Communications and Technology",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "locales/**/*",
      "assets/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "locales",
        "to": "locales"
      },
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Iraqi Government - Ministry of Communications and Technology",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Iraqi-AI-Chat-Setup-${version}.${ext}",
      "nsis": {
        "oneClick": false,
        "allowElevation": true,
        "allowToChangeInstallationDirectory": true,
        "installerIcon": "build/installer-icon.ico",
        "uninstallerIcon": "build/uninstaller-icon.ico",
        "installerHeaderIcon": "build/installer-header.ico",
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "language": "Arabic",
        "multiLanguageInstaller": true,
        "include": "build/installer.nsh",
        "guid": "iraqi-ai-chat-desktop-b48f4f8c-8b2a-4f8d-9c3d-1e2f3a4b5c6d"
      },
      "portable": {
        "artifactName": "Iraqi-AI-Chat-Portable-${version}.exe"
      },
      "msi": {
        "artifactName": "Iraqi-AI-Chat-Enterprise-${version}.msi"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Iraqi-AI-Chat-${version}-${arch}.${ext}"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "vendor": "Iraqi Government",
      "maintainer": "Iraqi Ministry of Communications <support@iraqi-ai.gov.iq>",
      "artifactName": "iraqi-ai-chat_${version}_${arch}.${ext}",
      "desktop": {
        "Comment[ar]": "نظام الدردشة الذكي العراقي للسطح المكتبي",
        "Comment[en]": "Iraqi AI Chat System Desktop Application",
        "Keywords": "iraqi;ai;chat;government;arabic;desktop",
        "StartupWMClass": "iraqi-ai-chat-desktop"
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libatk-bridge2.0-0",
        "libdrm2",
        "libxkbcommon0",
        "libxss1",
        "libasound2"
      ]
    },
    "rpm": {
      "depends": [
        "nss",
        "atk-bridge-atk",
        "libdrm",
        "libxkbcommon",
        "libXScrnSaver",
        "alsa-lib"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.iraqi-ai.gov.iq"
      }
    ],
    "compression": "maximum",
    "nsis": {
      "differentialPackage": true
    },
    "electronVersion": "27.1.3",
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@main/(.*)$": "<rootDir>/src/main/$1",
      "^@renderer/(.*)$": "<rootDir>/src/renderer/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}",
      "<rootDir>/src/**/__tests__/**/*.{ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/__tests__/**/*",
      "!src/**/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-hooks"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "react/prop-types": "off",
      "react/react-in-jsx-scope": "off"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "env": {
      "node": true,
      "electron": true,
      "browser": true,
      "es6": true
    }
  },
  "browserslist": [
    "Chrome >= 110"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
