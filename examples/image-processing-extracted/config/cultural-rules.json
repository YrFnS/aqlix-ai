{
  "islamic_compliance_rules": {
    "content_guidelines": {
      "prohibited_content": [
        "explicit_human_figures",
        "inappropriate_clothing",
        "alcohol_related_imagery",
        "gambling_content",
        "religious_symbols_misuse",
        "inappropriate_religious_references",
        "sectarian_content",
        "political_propaganda"
      ],

      "encouraged_content": [
        "respectful_human_representation",
        "modest_clothing_styles",
        "family_friendly_content",
        "educational_materials",
        "professional_contexts",
        "cultural_heritage_celebration",
        "architectural_elements",
        "nature_and_landscapes"
      ],

      "contextual_considerations": [
        "professional_vs_personal_use",
        "educational_vs_commercial_purpose",
        "target_audience_age_group",
        "cultural_sensitivity_level",
        "religious_observance_context"
      ]
    },

    "human_representation": {
      "guidelines": {
        "clothing": {
          "minimum_modesty_level": "conservative",
          "professional_attire_preferred": true,
          "cultural_appropriate_styles": [
            "business",
            "traditional",
            "modest_casual"
          ],
          "avoid": ["revealing", "tight_fitting", "inappropriate_for_context"]
        },

        "poses_and_gestures": {
          "professional_poses_preferred": true,
          "respectful_interactions_only": true,
          "avoid": [
            "inappropriate_gestures",
            "disrespectful_positions",
            "culturally_offensive_poses"
          ]
        },

        "facial_features": {
          "natural_representation": true,
          "respectful_portrayal": true,
          "cultural_sensitivity": "high"
        }
      },

      "exceptions": {
        "medical_context": {
          "anatomical_accuracy_allowed": true,
          "educational_purpose_priority": true,
          "professional_validation_required": true
        },

        "educational_context": {
          "historical_representation_allowed": true,
          "cultural_education_priority": true,
          "age_appropriate_content": true
        }
      }
    },

    "religious_sensitivity": {
      "islamic_elements": {
        "respectful_representation_required": true,
        "accurate_context_mandatory": true,
        "avoid_misinterpretation": true,
        "scholarly_validation_preferred": true
      },

      "interfaith_respect": {
        "inclusive_approach": true,
        "respectful_of_all_traditions": true,
        "avoid_comparative_judgments": true,
        "focus_on_shared_values": true
      },

      "cultural_symbols": {
        "proper_usage_required": true,
        "context_appropriate": true,
        "avoid_commercialization": true,
        "respect_sacred_meanings": true
      }
    }
  },

  "iraqi_cultural_guidelines": {
    "social_norms": {
      "family_values": {
        "respect_for_elders": "mandatory",
        "family_unity_emphasis": true,
        "intergenerational_respect": true,
        "traditional_roles_sensitivity": true
      },

      "hospitality_traditions": {
        "guest_honor_representation": true,
        "traditional_welcoming_customs": true,
        "food_sharing_cultural_significance": true,
        "home_sanctity_respect": true
      },

      "community_relationships": {
        "neighborly_respect": true,
        "community_support_emphasis": true,
        "collective_responsibility": true,
        "social_harmony_priority": true
      }
    },

    "professional_contexts": {
      "business_interactions": {
        "formal_respectful_tone": true,
        "hierarchy_acknowledgment": true,
        "patience_and_relationship_building": true,
        "trust_establishment_importance": true
      },

      "educational_settings": {
        "teacher_student_respect": true,
        "knowledge_reverence": true,
        "collaborative_learning": true,
        "practical_application_focus": true
      },

      "healthcare_environments": {
        "patient_dignity_priority": true,
        "family_involvement_consideration": true,
        "privacy_respect": true,
        "holistic_care_approach": true
      },

      "legal_contexts": {
        "justice_and_fairness_emphasis": true,
        "procedural_respect": true,
        "rights_and_responsibilities_balance": true,
        "community_impact_consideration": true
      }
    },

    "language_considerations": {
      "arabic_usage": {
        "iraqi_dialect_respect": true,
        "standard_arabic_formal_contexts": true,
        "respectful_language_mandatory": true,
        "cultural_expressions_preservation": true
      },

      "multilingual_contexts": {
        "arabic_english_balance": true,
        "cultural_code_switching_natural": true,
        "professional_terminology_accuracy": true,
        "respectful_translation_practices": true
      }
    }
  },

  "professional_domain_rules": {
    "legal": {
      "content_requirements": {
        "accuracy_priority": "highest",
        "formal_presentation": true,
        "neutrality_mandatory": true,
        "procedural_correctness": true
      },

      "cultural_adaptations": {
        "iraqi_legal_system_awareness": true,
        "islamic_law_considerations": true,
        "customary_practice_respect": true,
        "modern_legal_framework_integration": true
      },

      "prohibited_elements": [
        "legal_advice_provision",
        "case_specific_guidance",
        "judicial_bias_implication",
        "confidential_information_representation"
      ]
    },

    "medical": {
      "content_requirements": {
        "scientific_accuracy": "mandatory",
        "patient_dignity_respect": true,
        "cultural_sensitivity": "highest",
        "family_involvement_consideration": true
      },

      "representation_guidelines": {
        "modest_anatomical_representation": true,
        "gender_appropriate_contexts": true,
        "age_appropriate_content": true,
        "respectful_patient_portrayal": true
      },

      "prohibited_elements": [
        "medical_diagnosis_provision",
        "treatment_recommendations",
        "inappropriate_anatomical_display",
        "patient_confidentiality_breach"
      ]
    },

    "educational": {
      "content_requirements": {
        "age_appropriate_material": true,
        "culturally_relevant_examples": true,
        "inclusive_representation": true,
        "practical_application_focus": true
      },

      "cultural_integration": {
        "iraqi_history_respect": true,
        "local_context_incorporation": true,
        "traditional_knowledge_value": true,
        "modern_learning_methods": true
      }
    },

    "business": {
      "content_requirements": {
        "professional_standards": "high",
        "ethical_business_practices": true,
        "cultural_business_norms": true,
        "relationship_based_approach": true
      },

      "representation_guidelines": {
        "diverse_professional_representation": true,
        "respectful_workplace_dynamics": true,
        "collaborative_approaches": true,
        "innovation_with_tradition_balance": true
      }
    },

    "engineering": {
      "content_requirements": {
        "technical_accuracy": "mandatory",
        "safety_priority": "highest",
        "practical_applicability": true,
        "local_conditions_consideration": true
      },

      "cultural_adaptations": {
        "infrastructure_context_awareness": true,
        "environmental_considerations": true,
        "community_impact_assessment": true,
        "traditional_building_methods_respect": true
      }
    }
  },

  "validation_scoring": {
    "cultural_appropriateness": {
      "scoring_criteria": {
        "islamic_compliance": 0.4,
        "iraqi_cultural_norms": 0.3,
        "professional_context": 0.2,
        "language_respectfulness": 0.1
      },

      "threshold_levels": {
        "excellent": 0.95,
        "good": 0.85,
        "acceptable": 0.75,
        "needs_improvement": 0.65,
        "unacceptable": 0.65
      }
    },

    "automatic_rejection_triggers": [
      "explicit_inappropriate_content",
      "religious_disrespect",
      "cultural_insensitivity",
      "professional_inappropriateness",
      "safety_concerns",
      "legal_violations"
    ],

    "enhancement_opportunities": [
      "cultural_context_enrichment",
      "professional_terminology_improvement",
      "respectful_language_enhancement",
      "inclusive_representation_boost",
      "educational_value_addition"
    ]
  },

  "feedback_and_improvement": {
    "user_education": {
      "cultural_awareness_tips": true,
      "professional_context_guidance": true,
      "respectful_language_suggestions": true,
      "inclusive_representation_examples": true
    },

    "continuous_improvement": {
      "rule_refinement_process": true,
      "community_feedback_integration": true,
      "scholarly_consultation": true,
      "regular_review_schedule": "quarterly"
    }
  }
}
