# Staging Environment Configuration
# For staging/pre-production validation

NODE_ENV=staging
DEBUG=true
LOG_LEVEL=DEBUG

# Web Application
NEXT_PUBLIC_SITE_URL=https://staging.your-domain.com
NEXT_PUBLIC_API_URL=https://api-staging.your-domain.com
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_STAGING_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_STAGING_ANON_KEY}

# API Server
HOST=0.0.0.0
PORT=8000
API_SECRET_KEY=${API_SECRET_KEY_STAGING}
CORS_ALLOW_CREDENTIALS=true
CORS_ORIGINS=https://staging.your-domain.com,https://api-staging.your-domain.com

# Database (Staging database)
DATABASE_URL=${DATABASE_URL_STAGING}

# Cache
REDIS_URL=${REDIS_URL_STAGING}

# LLM Provider (OpenAI)
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Supabase (Staging project)
SUPABASE_URL=${SUPABASE_STAGING_URL}
SUPABASE_ANON_KEY=${SUPABASE_STAGING_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_STAGING_SERVICE_ROLE_KEY}

# Payment Gateways (Test/Sandbox Mode)
ZAINCASH_API_KEY=${ZAINCASH_TEST_API_KEY}
ZAINCASH_API_SECRET=${ZAINCASH_TEST_API_SECRET}
ZAINCASH_MERCHANT_ID=${ZAINCASH_TEST_MERCHANT_ID}

FASTPAY_API_KEY=${FASTPAY_TEST_API_KEY}
FASTPAY_API_SECRET=${FASTPAY_TEST_API_SECRET}
FASTPAY_MERCHANT_ID=${FASTPAY_TEST_MERCHANT_ID}

NASSWALLET_API_KEY=${NASSWALLET_TEST_API_KEY}
NASSWALLET_API_SECRET=${NASSWALLET_TEST_API_SECRET}
NASSWALLET_MERCHANT_ID=${NASSWALLET_TEST_MERCHANT_ID}

# Monitoring
SENTRY_DSN=${SENTRY_DSN_STAGING}
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# Features
CULTURAL_VALIDATION_ENABLED=true
ARABIC_DIALECT_PROCESSING=true
ENABLE_MULTIMODAL=true
ENABLE_VOICE=false

# Security
ISLAMIC_COMPLIANCE_LEVEL=standard
ALLOWED_REGIONS=baghdad,basra,mosul,erbil

# Email (Staging email service)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=${SENDGRID_API_KEY_STAGING}
EMAIL_FROM=staging-noreply@your-domain.com
EMAIL_FROM_NAME=Iraqi AI Chat System (Staging)

# OAuth
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID_STAGING}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET_STAGING}

MICROSOFT_CLIENT_ID=${MICROSOFT_CLIENT_ID_STAGING}
MICROSOFT_CLIENT_SECRET=${MICROSOFT_CLIENT_SECRET_STAGING}

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_CHAT_REQUESTS_PER_MINUTE=20

# Session Management
SESSION_DURATION_HOURS=24
SESSION_REFRESH_THRESHOLD_HOURS=1
MAX_CONCURRENT_SESSIONS=10

# MFA
MFA_ENABLED=true
MFA_ISSUER=Iraqi AI Chat System (Staging)
MFA_WINDOW=1

# Deployment
DEPLOYMENT_PLATFORM=railway
DEPLOYMENT_REGION=eu-west-1
DEPLOYMENT_AUTO_SCALE=true

# CDN
CDN_ENABLED=true
CDN_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=${CLOUDFLARE_ZONE_ID_STAGING}
CLOUDFLARE_API_KEY=${CLOUDFLARE_API_KEY}

# Domain
DOMAIN_NAME=staging.your-domain.com
DOMAIN_VERIFICATION_ENABLED=true

# SSL/TLS
SSL_ENABLED=true
SSL_PROVIDER=letsencrypt
SSL_AUTO_RENEWAL=true
